VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# 기본값 apple. 모든 OS에서 타종 오디오 사전 활성화를 사용하려면 all로 설정합니다.
# VITE_AUDIO_UNLOCK_SCOPE=all
# production에서는 항상 숨김. preview에서는 표시, 로컬 개발에서는 아래 값 사용.
VITE_AUDIO_DEBUG=false
# 셀프호스트 빌드 환경: production / preview
DEPLOY_ENV=production
# 비워 두거나 /sound이면 로컬 음원. CDN 사용 시 MP3가 있는 디렉터리 URL.
VITE_SOUND_BASE_URL=/sound
# R2 자동 배포: 최초 버킷/CDN/CORS 설정 후 true로 변경합니다.
# VITE_SOUND_BASE_URL=https://audio.example.com/sound
R2_SYNC_ENABLED=false
R2_PREFIX=sound
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Dokploy 도메인의 Container Port도 3000으로 설정합니다. HTTPS는 Dokploy 담당.
PORT=3000
LOG_DIR=/app/logs
# 직접 접속은 0. 신뢰할 수 있는 프록시만 거치도록 제한한 뒤 홉 수 지정.
TRUST_PROXY_HOPS=0
# 서버 런타임에만 전달됩니다. VITE_ 접두사를 붙이지 마세요.
# DISCORD_FEEDBACK_WEBHOOK_URL=https://discord.com/api/webhooks/...
